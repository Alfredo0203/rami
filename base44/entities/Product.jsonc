{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Product description"
    },
    "price": {
      "type": "number",
      "description": "Current base price"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Cost per unit for profit calculation"
    },
    "category_id": {
      "type": "string",
      "description": "Category ID"
    },
    "brand": {
      "type": "string",
      "description": "Product brand or manufacturer"
    },
    "color": {
      "type": "string",
      "description": "Primary color of the product (e.g. Rojo, Azul, Negro)"
    },
    "sku": {
      "type": "string",
      "description": "Base Stock Keeping Unit code for the product"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product image URLs"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Base stock (used when no variants exist)"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating (0-5), synced from Reviews"
    },
    "review_count": {
      "type": "number",
      "default": 0,
      "description": "Number of approved reviews, synced from Reviews"
    },
    "sold_count": {
      "type": "number",
      "default": 0,
      "description": "Number of items sold"
    },
    "is_featured": {
      "type": "boolean",
      "default": false,
      "description": "Featured product flag"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether product is visible"
    },
    "has_variants": {
      "type": "boolean",
      "default": false,
      "description": "Whether this product uses ProductVariant records instead of base stock/price"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Product tags for search"
    },
    "specifications": {
      "type": "object",
      "description": "Flexible key-value specs (e.g. { Material: 'Cotton', RAM: '8GB', Voltaje: '110V' })"
    },
    "weight_kg": {
      "type": "number",
      "description": "Product weight in kilograms (used for shipping calculations)"
    },
    "dimensions_cm": {
      "type": "object",
      "description": "Package dimensions in cm: { length, width, height }",
      "properties": {
        "length": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        }
      }
    },
    "store_id": {
      "type": "string",
      "description": "ID de la tienda (opcional - null si no tiene tienda)"
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "update": {},
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    }
  }
}