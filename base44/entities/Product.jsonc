{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "description": {
      "type": "string",
      "description": "Short description"
    },
    "full_description": {
      "type": "string",
      "description": "Full detailed description"
    },
    "price": {
      "type": "number",
      "description": "Base price"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount"
    },
    "category_id": {
      "type": "string",
      "description": "Category ID"
    },
    "brand": {
      "type": "string",
      "description": "Product brand or manufacturer"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Base product image URLs"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Stock when no variants"
    },
    "rating": {
      "type": "number",
      "default": 0,
      "description": "Average rating (0-5)"
    },
    "review_count": {
      "type": "number",
      "default": 0,
      "description": "Number of reviews"
    },
    "sold_count": {
      "type": "number",
      "default": 0,
      "description": "Number of items sold"
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "has_variants": {
      "type": "boolean",
      "default": false,
      "description": "True if this product uses variants/SKUs"
    },
    "variant_options": {
      "type": "array",
      "description": "Variant option groups e.g. [{name:'Color', values:['Rojo','Azul']}, {name:'Talla', values:['S','M','L']}]",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "color_images": {
      "type": "object",
      "description": "Map of color value -> array of image URLs. e.g. {Rojo: ['url1','url2']}"
    },
    "attributes": {
      "type": "object",
      "description": "Category-specific attributes as key-value pairs. e.g. {Material:'Algod\u00f3n', Fit:'Regular', Voltage:'110V'}"
    }
  },
  "required": [
    "name",
    "price"
  ]
}