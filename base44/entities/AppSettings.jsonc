{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. 'global')"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo URL for branding (used in PDFs, emails, etc.)"
    },
    "development_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, restricts regular users to Home only"
    },
    "allowed_payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "credit_card"
      ],
      "description": "List of enabled payment methods: credit_card, cash_on_delivery"
    },
    "disabled_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of page paths disabled for regular users (e.g. ['Browse', 'Orders'])"
    },
    "promo_banner_label": {
      "type": "string",
      "default": "Flash Sale",
      "description": "Small label text above the main banner title"
    },
    "promo_banner_title": {
      "type": "string",
      "default": "Up to 70% OFF",
      "description": "Main bold title of the promo banner"
    },
    "promo_banner_subtitle": {
      "type": "string",
      "default": "Created by Alfred & Raquel",
      "description": "Subtitle / description text of the promo banner"
    },
    "promo_banner_link": {
      "type": "string",
      "description": "URL or page path to navigate when tapping the banner"
    },
    "promo_banner_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the promo banner on the home page"
    },
    "promo_banner_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO datetime when the promo banner auto-expires and turns off"
    },
    "whatsapp_phone": {
      "type": "string",
      "default": "+50370000000",
      "description": "WhatsApp phone number for support (format: +503XXXXXXXX)"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of admin who last updated"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    }
  },
  "required": [
    "key"
  ]
}