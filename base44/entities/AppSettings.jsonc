{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. 'global')"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo URL for branding (used in PDFs, emails, etc.)"
    },
    "development_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, restricts regular users to Home only"
    },
    "allowed_payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "credit_card"
      ],
      "description": "List of enabled payment methods: credit_card, cash_on_delivery"
    },
    "disabled_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of page paths disabled for regular users (e.g. ['Browse', 'Orders'])"
    },
    "promo_banner_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether to show the promo banner on the home page"
    },
    "promo_banner_label": {
      "type": "string",
      "description": "Small label above the title (e.g. 'Flash Sale')"
    },
    "promo_banner_title": {
      "type": "string",
      "description": "Main headline of the promo banner"
    },
    "promo_banner_subtitle": {
      "type": "string",
      "description": "Subtitle / description below the title"
    },
    "promo_banner_link": {
      "type": "string",
      "description": "Internal path or external URL the banner arrow links to (e.g. '/Browse')"
    },
    "promo_banner_image_url": {
      "type": "string",
      "description": "Optional background image URL for the banner"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of admin who last updated"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    }
  },
  "required": [
    "key"
  ]
}