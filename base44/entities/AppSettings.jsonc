{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. 'global')"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo URL for branding (used in PDFs, emails, etc.)"
    },
    "development_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, restricts regular users to Home only"
    },
    "allowed_payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "credit_card"
      ],
      "description": "List of enabled payment methods: credit_card, cash_on_delivery"
    },
    "disabled_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of page paths disabled for regular users (e.g. ['Browse', 'Orders'])"
    },
    "banner_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether the promo banner is shown on Home"
    },
    "banner_title": {
      "type": "string",
      "description": "Main headline of the promo banner (e.g. 'Up to 70% OFF')"
    },
    "banner_subtitle": {
      "type": "string",
      "description": "Subtitle text under the banner headline"
    },
    "banner_image_url": {
      "type": "string",
      "description": "Optional background image URL for the banner"
    },
    "banner_link": {
      "type": "string",
      "description": "Optional URL or page path to navigate when tapping the banner"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of admin who last updated"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    }
  },
  "required": [
    "key"
  ]
}