{
  "name": "AppSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Setting key (e.g. 'global')"
    },
    "logo_url": {
      "type": "string",
      "description": "Logo URL for branding (used in PDFs, emails, etc.)"
    },
    "development_mode": {
      "type": "boolean",
      "default": false,
      "description": "When true, restricts regular users to Home only"
    },
    "allowed_payment_methods": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [
        "credit_card"
      ],
      "description": "List of enabled payment methods: credit_card, cash_on_delivery"
    },
    "disabled_pages": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of page paths disabled for regular users (e.g. ['Browse', 'Orders'])"
    },
    "promo_banner": {
      "type": "object",
      "description": "Configurable promotional banner shown on the home screen",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "badge_text": {
          "type": "string",
          "description": "Small badge label (e.g. 'Flash Sale')"
        },
        "title": {
          "type": "string",
          "description": "Main headline (e.g. 'Up to 70% OFF')"
        },
        "subtitle": {
          "type": "string",
          "description": "Secondary text below the title"
        },
        "link_url": {
          "type": "string",
          "description": "Optional URL to navigate when tapped"
        }
      }
    },
    "updated_by": {
      "type": "string",
      "description": "Email of admin who last updated"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of last update"
    }
  },
  "required": [
    "key"
  ]
}