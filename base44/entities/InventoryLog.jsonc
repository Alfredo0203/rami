{
  "name": "InventoryLog",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID del producto"
    },
    "variant_id": {
      "type": "string",
      "description": "ID de la variante (opcional - null si el producto no tiene variantes)"
    },
    "quantity": {
      "type": "number",
      "description": "Cantidad de unidades (positivo = entrada, negativo = salida)"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Costo unitario en este registro"
    },
    "total_cost": {
      "type": "number",
      "description": "Costo total (cantidad \u00d7 cost_per_unit)"
    },
    "notes": {
      "type": "string",
      "description": "Notas opcionales"
    },
    "order_id": {
      "type": "string",
      "description": "ID de la orden (para salidas por venta)"
    },
    "movement_type": {
      "type": "string",
      "enum": [
        "purchase",
        "sale",
        "adjustment",
        "return"
      ],
      "default": "adjustment",
      "description": "Tipo de movimiento: compra, venta, ajuste o devoluci\u00f3n"
    }
  },
  "required": [
    "product_id",
    "quantity",
    "cost_per_unit"
  ],
  "rls": {
    "read": {
      "user.role": "admin"
    },
    "create": {
      "user.role": "admin"
    },
    "update": {
      "user.role": "admin"
    },
    "delete": {
      "user.role": "admin"
    }
  }
}