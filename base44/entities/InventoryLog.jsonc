{
  "name": "InventoryLog",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID del producto"
    },
    "quantity": {
      "type": "number",
      "description": "Cantidad de unidades agregadas"
    },
    "cost_per_unit": {
      "type": "number",
      "description": "Costo unitario en este registro"
    },
    "total_cost": {
      "type": "number",
      "description": "Costo total (cantidad \u00d7 cost_per_unit)"
    },
    "notes": {
      "type": "string",
      "description": "Notas opcionales"
    }
  },
  "required": [
    "product_id",
    "quantity",
    "cost_per_unit"
  ]
}