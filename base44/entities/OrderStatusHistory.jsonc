{
  "name": "OrderStatusHistory",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID de la orden"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario propietario de la orden"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "description": "Estado registrado"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora del cambio de estado"
    },
    "notes": {
      "type": "string",
      "description": "Notas opcionales sobre el cambio de estado"
    }
  },
  "required": [
    "order_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user.role": {
            "$in": [
              "admin",
              "super_admin"
            ]
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {
      "user.role": {
        "$in": [
          "admin",
          "super_admin"
        ]
      }
    },
    "update": {
      "user.role": {
        "$in": [
          "admin",
          "super_admin"
        ]
      }
    },
    "delete": {
      "user.role": {
        "$in": [
          "admin",
          "super_admin"
        ]
      }
    }
  }
}