{
  "name": "Wishlist",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID (explicit foreign key)"
    },
    "product_id": {
      "type": "string",
      "description": "ID del producto guardado en favoritos"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto (snapshot)"
    },
    "product_image": {
      "type": "string",
      "description": "Imagen principal del producto (snapshot)"
    },
    "product_price": {
      "type": "number",
      "description": "Precio del producto al momento de guardar (snapshot)"
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}