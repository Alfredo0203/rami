{
  "name": "Wishlist",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "ID del producto guardado en favoritos"
    },
    "user_email": {
      "type": "string",
      "description": "Email del usuario propietario del wishlist"
    },
    "product_name": {
      "type": "string",
      "description": "Nombre del producto (snapshot)"
    },
    "product_image": {
      "type": "string",
      "description": "Imagen principal del producto (snapshot)"
    },
    "product_price": {
      "type": "number",
      "description": "Precio del producto al momento de guardar (snapshot)"
    }
  },
  "required": [
    "product_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user.role": {
            "$in": [
              "admin",
              "super_admin"
            ]
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": {
            "$in": [
              "admin",
              "super_admin"
            ]
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": {
            "$in": [
              "admin",
              "super_admin"
            ]
          }
        },
        {
          "data.user_email": "{{user.email}}"
        }
      ]
    },
    "create": {}
  }
}