{
  "name": "SearchHistory",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "description": "T\u00e9rminos de b\u00fasqueda"
    },
    "search_count": {
      "type": "number",
      "default": 1,
      "description": "N\u00famero de veces que se ha hecho esta b\u00fasqueda"
    }
  },
  "required": [
    "query"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    }
  }
}