{
  "name": "Address",
  "type": "object",
  "properties": {
    "label": {
      "type": "string",
      "description": "Etiqueta (Casa, Trabajo, etc.)"
    },
    "first_name": {
      "type": "string",
      "description": "Nombre"
    },
    "last_name": {
      "type": "string",
      "description": "Apellido"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono con prefijo +503"
    },
    "departamento": {
      "type": "string"
    },
    "municipio": {
      "type": "string"
    },
    "colonia": {
      "type": "string",
      "description": "Colonia / Residencial / Barrio"
    },
    "street": {
      "type": "string",
      "description": "Calle / Pasaje / Avenida"
    },
    "house_number": {
      "type": "string",
      "description": "N\u00famero de casa"
    },
    "reference": {
      "type": "string",
      "description": "Punto de referencia (opcional)"
    },
    "country": {
      "type": "string",
      "default": "El Salvador"
    },
    "is_default": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone",
    "departamento",
    "municipio",
    "colonia",
    "street",
    "house_number"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}