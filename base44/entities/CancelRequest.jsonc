{
  "name": "CancelRequest",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID de la orden relacionada"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero de orden (para visualizaci\u00f3n r\u00e1pida)"
    },
    "customer_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "order_status": {
      "type": "string",
      "description": "Estado de la orden al momento de la solicitud"
    },
    "order_total": {
      "type": "number",
      "description": "Total de la orden"
    },
    "payment_method": {
      "type": "string",
      "description": "M\u00e9todo de pago de la orden"
    },
    "payment_status": {
      "type": "string",
      "description": "Estado del pago de la orden"
    },
    "payment_transaction_id": {
      "type": "string",
      "description": "ID de la transacci\u00f3n en Stripe (si aplica)"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "cancel_request",
        "refund_request",
        "return_request"
      ],
      "default": "cancel_request",
      "description": "Tipo de solicitud"
    },
    "reason": {
      "type": "string",
      "description": "Motivo de la solicitud dado por el cliente o sistema"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_review",
        "approved",
        "rejected"
      ],
      "default": "pending_review",
      "description": "Estado de la solicitud"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas del admin al resolver la solicitud"
    },
    "resolved_by": {
      "type": "string",
      "description": "Email del admin que resolvi\u00f3 la solicitud"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha de resoluci\u00f3n"
    },
    "stripe_refund_id": {
      "type": "string",
      "description": "ID del reembolso en Stripe si fue aprobado"
    }
  },
  "required": [
    "order_id",
    "order_number",
    "customer_email",
    "request_type"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.customer_email": "{{user.email}}"
        },
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    }
  }
}