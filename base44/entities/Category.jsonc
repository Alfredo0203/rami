{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "icon": {
      "type": "string",
      "description": "Lucide icon name for the category"
    },
    "image_url": {
      "type": "string",
      "description": "Category banner image URL"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ],
  "rls": {}
}