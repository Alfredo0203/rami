{
  "name": "ProductVariant",
  "type": "object",
  "properties": {
    "product_id": {
      "type": "string",
      "description": "Parent product ID"
    },
    "sku": {
      "type": "string",
      "description": "Stock Keeping Unit code"
    },
    "name": {
      "type": "string",
      "description": "Variant display name (e.g. 'Rojo / M / L / XL')"
    },
    "attributes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "description": "Attribute type (e.g. 'Color', 'Talla', 'Material')"
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Array of values for this attribute (e.g. ['M', 'L', 'XL'])"
          }
        },
        "required": [
          "key",
          "values"
        ]
      },
      "description": "Array of attribute groups, each with key and multiple values (allows same key with multiple values)"
    },
    "price": {
      "type": "number",
      "description": "Override price for this variant (if different from base product price)"
    },
    "original_price": {
      "type": "number",
      "description": "Original price before discount for this variant"
    },
    "stock": {
      "type": "number",
      "default": 0,
      "description": "Stock units available for this specific variant"
    },
    "image_url": {
      "type": "string",
      "description": "Variant-specific image (e.g. color swatch photo)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this variant is available for purchase"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order among variants"
    }
  },
  "required": [
    "product_id",
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    }
  }
}