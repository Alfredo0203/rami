{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Unique order number"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "variant_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "variant_name": {
            "type": "string"
          },
          "product_image": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      },
      "description": "Order items snapshot"
    },
    "subtotal": {
      "type": "number"
    },
    "discount_amount": {
      "type": "number",
      "default": 0,
      "description": "Total discount applied (from coupon or promotion)"
    },
    "coupon_code": {
      "type": "string",
      "description": "Coupon code used on this order"
    },
    "coupon_id": {
      "type": "string",
      "description": "Coupon ID (explicit foreign key)"
    },
    "address_id": {
      "type": "string",
      "description": "Address ID (explicit foreign key)"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "shipped",
        "delivered",
        "cancelled"
      ],
      "default": "pending"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "credit_card",
        "paypal",
        "apple_pay",
        "cash_on_delivery"
      ],
      "default": "credit_card"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "paid",
        "pending_payment",
        "failed"
      ],
      "default": "pending_payment",
      "description": "Payment status of the order"
    },
    "payment_transaction_id": {
      "type": "string",
      "description": "Transaction ID from the payment gateway (e.g. Stripe charge ID)"
    },
    "shipping_address": {
      "type": "object",
      "properties": {
        "full_name": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        },
        "street": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip_code": {
          "type": "string"
        },
        "country": {
          "type": "string"
        }
      }
    },
    "tracking_number": {
      "type": "string"
    },
    "carrier": {
      "type": "string",
      "description": "Shipping carrier name (e.g. DHL, FedEx, Correos)"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_notes": {
      "type": "string",
      "description": "Notes left by the customer at checkout"
    },
    "internal_notes": {
      "type": "string",
      "description": "Internal admin notes about the order"
    }
  },
  "required": [
    "items",
    "total",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        },
        {
          "created_by": "{{user.email}}"
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user.role": "admin"
        },
        {
          "user.role": "super_admin"
        }
      ]
    }
  }
}