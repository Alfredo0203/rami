{
  "name": "RefundRequest",
  "type": "object",
  "properties": {
    "order_id": {
      "type": "string",
      "description": "ID de la orden cancelada"
    },
    "order_number": {
      "type": "string",
      "description": "N\u00famero de orden (snapshot)"
    },
    "customer_email": {
      "type": "string",
      "description": "Email del cliente"
    },
    "customer_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "wompi",
        "credit_card",
        "paypal"
      ],
      "description": "M\u00e9todo de pago que requiere reembolso manual"
    },
    "payment_transaction_id": {
      "type": "string",
      "description": "ID de transacci\u00f3n en la pasarela (Wompi tx, etc.)"
    },
    "amount": {
      "type": "number",
      "description": "Monto a reembolsar"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processed",
        "failed"
      ],
      "default": "pending",
      "description": "Estado del reembolso: pendiente, procesado o fallido"
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha cuando el admin marc\u00f3 el reembolso como procesado"
    },
    "processed_by": {
      "type": "string",
      "description": "Email del admin que proces\u00f3 el reembolso"
    },
    "admin_notes": {
      "type": "string",
      "description": "Notas internas del admin sobre el reembolso"
    }
  },
  "required": [
    "order_id",
    "payment_method",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "super_admin"
          }
        }
      ]
    }
  }
}